<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Identity | CivicTrace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: { brand: { black: '#0a0a0a', blue: '#0052FF', border: '#e5e7eb' } }
                }
            }
        }
    </script>
</head>
<body class="font-sans antialiased bg-gray-50 text-brand-black min-h-screen flex flex-col justify-center py-12 sm:px-6 lg:px-8">

    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="flex justify-center items-center gap-2 mb-6">
            <div class="w-6 h-6 bg-brand-black rounded-sm"></div>
            <a href="/" class="text-2xl font-bold tracking-tight">CivicTrace</a>
        </div>
        <h2 class="text-center text-3xl font-extrabold text-gray-900">Register Entity</h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            Join your local jurisdiction to audit public infrastructure.
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow-sm border border-gray-200 sm:rounded-xl sm:px-10">
            
            <div class="mb-6 bg-blue-50 border border-blue-100 rounded-md p-4 flex gap-3">
                <svg class="h-5 w-5 text-brand-blue flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <p class="text-xs text-blue-800 leading-relaxed">
                    <strong>System Integrity Notice:</strong> Your Aadhaar hash and selected jurisdiction are immutable. Once registered, this assignment is permanently locked.
                </p>
            </div>

            <form class="space-y-6" action="/api/auth/register" method="POST">
                
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700">Full Legal Name</label>
                    <div class="mt-1">
                        <input id="name" name="name" type="text" required class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-brand-blue focus:border-brand-blue sm:text-sm">
                    </div>
                </div>

                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
                    <div class="mt-1">
                        <input id="email" name="email" type="email" required class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-brand-blue focus:border-brand-blue sm:text-sm">
                    </div>
                </div>

                <div>
                    <label for="aadhaarNumber" class="block text-sm font-medium text-gray-700">Aadhaar Number (12 Digits)</label>
                    <div class="mt-1">
                        <input id="aadhaarNumber" name="aadhaarNumber" type="text" minlength="12" maxlength="12" required class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-brand-blue focus:border-brand-blue sm:text-sm" placeholder="XXXX XXXX XXXX">
                    </div>
                </div>

                <div>
                    <label for="villageId" class="block text-sm font-medium text-gray-700">Select Jurisdiction (Village/Ward)</label>
                    <div class="mt-1">
                        <select id="villageId" name="villageId" required class="mt-1 block w-full pl-3 pr-10 py-2 text-base border border-gray-300 focus:outline-none focus:ring-brand-blue focus:border-brand-blue sm:text-sm rounded-md">
                            <option value="" disabled selected>-- Select your area --</option>
                            <% if (villages && villages.length > 0) { %>
                                <% villages.forEach(function(village) { %>
                                    <option value="<%= village._id %>"><%= village.name %> (<%= village.district %>)</option>
                                <% }); %>
                            <% } else { %>
                                <option value="" disabled>No jurisdictions available. Admin must initialize database.</option>
                            <% } %>
                        </select>
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
                    <div class="mt-1">
                        <input id="password" name="password" type="password" required class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-brand-blue focus:border-brand-blue sm:text-sm">
                    </div>
                </div>

                <div>
                    <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-semibold text-white bg-brand-black hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors">
                        Register Account
                    </button>
                </div>
            </form>

            <div class="mt-6 text-center text-sm">
                <span class="text-gray-500">Already have an account?</span>
                <a href="/login" class="font-medium text-brand-blue hover:text-blue-700">Sign in</a>
            </div>
            
        </div>
    </div>
</body>
</html>